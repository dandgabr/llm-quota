# llm-quota compose secrets — copy to docker/.env and fill.
# This file is git-ignored (docker/.env). Never commit real secrets.

# --- Postgres ---
POSTGRES_USER=llmquota
POSTGRES_PASSWORD=change-me
POSTGRES_DB=llm_quota

# --- Secrets (envelope + session) ---
# LLM_QUOTA_KEK: openssl rand -base64 32
LLM_QUOTA_KEK=
# SESSION_SECRET: >= 32 chars
SESSION_SECRET=

# --- API ---
NODE_ENV=production
WEB_ORIGIN=https://localhost

# --- OIDC (optional until wired) ---
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=

# --- Web ---
VITE_API_URL=https://localhost
# Host port for the web service (http on 8080; TLS terminated by the edge/CA).
WEB_HTTP_PORT=8080

# --- TLS (local testing ONLY; production uses real CA via the edge) ---
TLS_CERT_PATH=
TLS_KEY_PATH=
