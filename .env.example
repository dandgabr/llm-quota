# --- Server ---
NODE_ENV=development
PORT=3000

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=llmquota
POSTGRES_PASSWORD=change-me
POSTGRES_DB=llm_quota
DATABASE_URL=postgres://llmquota:change-me@localhost:5432/llm_quota
# Max pooled connections for the API process (read by resolveDatabaseConfig).
PG_MAX_CONNECTIONS=10

# --- Secrets (envelope encryption - KEK) ---
# Set a random 32-byte base64 value: openssl rand -base64 32
LLM_QUOTA_KEK=

# --- Auth hardening (E2/E3/E4/E5) ---
# HMAC pepper for login-throttle keys and MFA recovery codes (>= 32 chars).
# Fail-closed: a missing/short RECOVERY_PEPPER disables recovery (never falls
# back to an unpeppered hash).
AUTH_PEPPER=
RECOVERY_PEPPER=
# Idle session timeout in seconds (0 disables; absolute expiry still applies).
SESSION_IDLE_TTL_SECONDS=1800
# Step-up reauthentication window in seconds for MFA enroll/disable (0 = always ask).
STEP_UP_TTL_SECONDS=300
# Account+IP login lockout (durable). Never a hard lock by email alone.
LOCKOUT_ENABLED=1
LOCKOUT_IP_THRESHOLD=5
LOCKOUT_WINDOW_SECONDS=900
LOCKOUT_BASE_SECONDS=30
LOCKOUT_MAX_SECONDS=3600
LOGIN_ATTEMPT_TTL_SECONDS=86400
# TOTP issuer shown in authenticator apps.
TOTP_ISSUER=llm-quota
# >= 32 chars; also the HMAC secret for session signatures.
SESSION_SECRET=
# Dev-only session issuance endpoint (POST /auth/issue-session) + dev OIDC/MFA
# challenge endpoints. Refused outside NODE_ENV=development|test. Removed in Phase D.
ENABLE_DEV_SESSION=0

# --- Web / CORS / SPA ---
# Exact origin allow-list (dev ports localhost:5173/4173 are always allowed).
WEB_ORIGIN=http://localhost:5173
# Absolute path to the built SPA; when set the API serves it same-origin and
# returns index.html for unknown non-API GET routes.
WEB_DIST_PATH=
# Base URL used to build invite links (defaults to same-origin relative).
PUBLIC_WEB_URL=
# Set to 1 ONLY behind a trusted reverse proxy (honours X-Forwarded-For for
# rate limiting). Never trust those headers otherwise.
TRUST_PROXY=0

# --- OIDC (RESERVED — not wired yet; see docs/architecture/security.md) ---
# The authorization-challenge endpoint is dev-gated until server-side
# state/verifier persistence ships. These vars are placeholders.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=http://localhost:5173/callback

# --- FX (currency conversion) ---
# RESERVED: the FX engine accepts an injected fetcher; no HTTP fetcher is
# bundled yet, so these vars are currently unread.
FX_API_BASE=
FX_API_KEY=

# --- Collector scheduler ---
# Poll interval for the quota collector (ms). 0 disables the scheduler.
COLLECT_INTERVAL_MS=60000

# --- TLS (local testing ONLY) ---
# Generated by scripts/cert-local.sh into certs/. Never committed.
# Production uses a real-CA certificate + ACME; these vars are ignored/refused
# in NODE_ENV=production (the cert-local guard rejects local.* there).
TLS_CERT_PATH=certs/local.crt
TLS_KEY_PATH=certs/local.key

# --- Seed bootstrap (optional) ---
# When set, `pnpm --filter @llm-quota/db seed` creates this admin user.
SEED_ADMIN_EMAIL=
SEED_ADMIN_ROLE=admin
