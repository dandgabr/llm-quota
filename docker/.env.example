# llm-quota compose secrets — copy to docker/.env and fill.
# This file is git-ignored (docker/.env). Never commit real secrets.

# --- Postgres ---
POSTGRES_USER=llmquota
POSTGRES_PASSWORD=change-me
POSTGRES_DB=llm_quota
# NON-SUPERUSER pool identity used by the api service (FORCE RLS applies).
# openssl rand -hex 16
POSTGRES_APP_PASSWORD=

# --- Secrets (envelope + session) ---
# LLM_QUOTA_KEK: openssl rand -base64 32
LLM_QUOTA_KEK=
# SESSION_SECRET: >= 32 chars
SESSION_SECRET=

# --- API ---
NODE_ENV=production
WEB_ORIGIN=https://localhost
# Collector poll interval (ms); 0 disables.
COLLECT_INTERVAL_MS=60000
PG_MAX_CONNECTIONS=10
# Dev-only session issuance: leave EMPTY in production (refused there anyway).
ENABLE_DEV_SESSION=

# --- OIDC (RESERVED — not wired yet) ---
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URL=

# --- Web ---
VITE_API_URL=https://localhost
# Host port for the web service (loopback-only; TLS terminated by the edge).
WEB_HTTP_PORT=8080

# --- Edge (--profile edge) ---
# Certificates mounted from ../certs into the edge container.

# --- Ops (--profile ops) ---
# Loopback-only Postgres port for host-side migrate/seed.
POSTGRES_OPS_PORT=15432

# --- TLS (api-level; local testing ONLY — production uses the edge) ---
TLS_CERT_PATH=
TLS_KEY_PATH=

# --- First-run bootstrap (host-side seed) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_ROLE=admin
